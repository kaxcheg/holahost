# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment files. A real dev/.env is a per-developer local copy and stays ignored; staging/.env
# and prod/.env hold non-secret runtime settings and are committed, so they are un-ignored by path
# rather than by a basename glob that would also catch dev/.env.
*.env
.env.*
!.env.*.example
!**/.env.example
!**/infra/envs/staging/.env
!**/infra/envs/prod/.env

# OS / editor
.DS_Store
*.swp
.vscode/

# Local tooling state
.build-state/
.claude/
CLAUDE.md

# Specification drafts kept locally; the published versions live in docs/
**/ru_docs/

# Terraform (keep .terraform.lock.hcl tracked)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
