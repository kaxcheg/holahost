# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment files
*.env
.env.*
!.env.example
# staging/prod be-env hold NO secrets (those live in Secrets Manager) → committed so Terraform reads
# them directly as the Lambda env source (I-12). dev.env stays ignored (holds DEV_ANTHROPIC_API_KEY).
!infra/envs/staging/staging.env
!infra/envs/prod/prod.env

# OS / editor
.DS_Store
*.swp

# Claude Code / build-session process state (local working memory)
.build-state/
.claude/
settings.json

# Node
node_modules/
frontend/dist/

# Terraform (keep .terraform.lock.hcl tracked)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
