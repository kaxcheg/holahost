# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment files. Two naming conventions coexist: the older <svc-root>/.env.<env>.example
# (env name in the filename) and the newer infra/envs/<env>/.env.example + infra/envs/<env>/.env
# (env name is the directory instead — real dev/.env stays a per-developer local copy and must
# stay ignored; real staging/.env and prod/.env are non-secret and safe to commit, so are
# explicitly un-ignored by path, not by a basename glob that would also catch dev/.env).
*.env
.env.*
!.env.*.example
!**/.env.example
!**/infra/envs/staging/.env
!**/infra/envs/prod/.env

# OS / editor
.DS_Store
*.swp

# Claude Code / build-session process state (local working memory)
.build-state/
.claude/
settings.json
CLAUDE.md

# Node
node_modules/
frontend/dist/

# Terraform (keep .terraform.lock.hcl tracked)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
