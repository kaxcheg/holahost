# hola.host — FRONTEND config TEMPLATE. COMMITTED. Copy to `frontend/.env` (gitignored) for local dev:
#   cp frontend/.env.example frontend/.env
#
# Frontend-owned magic-link URL contract (source of truth) — invariant constants, NOT per-env:
#   MAGIC_LINK_URL_PARAM  query param carrying the token; the frontend bakes it into its bundle
#   MAGIC_LINK_PATH       SPA landing path the link points to; consumed by BOTH the frontend (to scope the
#                         landing route, boot/magic-link-landing) and the backend (to build the email link)
# Terraform relays both into the backend Lambda (I-12); in dev, docker-compose feeds them to the backend
# as a second env_file. See docs/settings-inventory.md.
MAGIC_LINK_PATH=/claim
MAGIC_LINK_URL_PARAM=ml
