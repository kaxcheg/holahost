{
  "name": "holahost-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build": "vite build --mode prod",
    "build:dev": "vite build --mode dev",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview --mode prod",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "generate-types": "openapi-typescript ../services/lead-capture/docs/openapi.yaml -o src/api/generated.ts"
  },
  "dependencies": {
    "@preact/signals-core": "^1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.7",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
