              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadTooLargeErrorResponse"
                }
              }
            },
            "description": "File over MAX_UPLOAD_SIZE."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeErrorResponse"
                }
              }
            },
            "description": "MIME type outside the whitelist."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestErrorResponse"
                }
              }
            },
            "description": "The upload could not be accepted."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorResponse"
                }
              }
            },
            "description": "Out of contract — see the log."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create Document",
        "tags": [
          "documents"
        ]
      }
