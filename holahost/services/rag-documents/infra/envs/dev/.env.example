ENV=dev
# config.settings.Settings always assembles database_url from these three (host/port are a
# separate Settings field too, defaulting to the fixed "postgres"/5432 convention — not
# env-specific, not set here) — one source, not a separate DATABASE_URL literal that could
# disagree with itself.
#
# POSTGRES_USER/POSTGRES_PASSWORD are the APPLICATION's own role: unprivileged, created by
# scripts/provision_app_role.py during `make migrate-dev`, and deliberately NOT the postgres
# container's initdb superuser (docker-compose.yml gives that one its own name and password —
# POSTGRES_SUPERUSER/POSTGRES_SUPERUSER_PASSWORD below). Owner isolation in this service rests
# entirely on row-level security, which a superuser bypasses unconditionally, so the app
# refuses to start if it ever connects as a role that can (scripts/bootstrap.py).
POSTGRES_USER=rag_documents
POSTGRES_PASSWORD=rag_documents
POSTGRES_DB=rag_documents

# The postgres container's bootstrap superuser password — the credential migrations and role
# provisioning authenticate with, never the running app. Present in this file only because dev
# has no Secrets Manager; staging/prod carry NEITHER password here and fetch both from it.
#
# In this file rather than as a literal in the Makefile, because this file is the only source
# that reaches both consumers from one declaration: `--env-file` feeds Compose's `${...}`
# interpolation (docker-compose.yml's `postgres` service), and the `env_file:` key feeds the
# one-off `api` containers where SuperuserSettings reads it. The Makefile could only reach the
# first, so it had to pass the value twice, on every command.
#
# Not a secret at dev's threat level: no environment publishes a Postgres port at all, so this
# role is reachable only from inside the compose project's own network. It must still differ
# from POSTGRES_PASSWORD above — sharing one value would hand the RLS bypass to anything holding
# the app's credentials, which is the whole point of keeping the two roles apart.
POSTGRES_SUPERUSER_PASSWORD=dev-bootstrap-superuser-not-a-secret
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=/opt/model-cache
CHUNK_WINDOW_TOKENS=120
CHUNK_OVERLAP_TOKENS=16
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.30
MAX_QUERY_LENGTH=4000
# Requests per hour, fixed window, no burst. Two dimensions: what the operation costs
# (ingest = create/replace; read = search/get/delete) and what the ceiling counts.
# A service token's `sub` is its own `client_id`, so SERVICE_* is one aggregate for the
# whole calling integration; USER_* applies per user of an exchanged token.
# Service ceilings start equal to the user ones — calibration needs the per-stage
# timings that op_completed does not carry yet (spec, deferred decisions).
RATE_LIMIT_USER_INGEST=60
RATE_LIMIT_USER_READ=600
RATE_LIMIT_SERVICE_INGEST=60
RATE_LIMIT_SERVICE_READ=600
JWT_CLOCK_SKEW_SECONDS=30
# Until auth exists, JWKS/issuer/audience point at the dev-minter setup described in the
# runbook's dev section (a stub — the minter itself does not exist yet).
JWKS_URL=http://localhost:8081/.well-known/jwks.json
EXPECTED_ALGORITHM=RS256
EXPECTED_ISSUER=holahost-dev
EXPECTED_AUDIENCE=rag-documents
HOST_PORT=8080
