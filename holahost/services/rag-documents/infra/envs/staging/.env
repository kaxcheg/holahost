# Non-secret runtime settings for staging. Committed on purpose: neither database password is
# here — both live in Secrets Manager, and docs/runbook.md explains which is which and why they
# must differ. AWS_REGION is read directly by app/scripts/bootstrap.py, before Settings exists,
# so it can reach Secrets Manager at all.
ENV=staging
AWS_REGION=us-east-1
POSTGRES_USER=rag_documents
POSTGRES_DB=rag_documents
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=/opt/model-cache
CHUNK_WINDOW_TOKENS=120
CHUNK_OVERLAP_TOKENS=16
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.30
MAX_QUERY_LENGTH=4000
# Requests per hour, fixed window, no burst. Two dimensions: what the operation costs
# (ingest = create/replace; read = search/get/delete) and what the ceiling counts. A service
# token's `sub` is its own `client_id`, so SERVICE_* is one aggregate for the whole calling
# integration; USER_* applies per user of an exchanged token. Service ceilings start equal to
# the user ones, to be calibrated once there is traffic to calibrate against.
RATE_LIMIT_USER_INGEST=60
RATE_LIMIT_USER_READ=600
RATE_LIMIT_SERVICE_INGEST=60
RATE_LIMIT_SERVICE_READ=600
JWT_CLOCK_SKEW_SECONDS=30
# The issuer these point at does not exist yet; fill them in once it is deployed.
JWKS_URL=https://auth.staging.hola.host/.well-known/jwks.json
EXPECTED_ALGORITHM=RS256
EXPECTED_ISSUER=https://auth.staging.hola.host
EXPECTED_AUDIENCE=rag-documents
