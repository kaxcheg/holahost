# Non-secret runtime settings for prod. Committed — and BOTH database passwords are
# deliberately absent, because they are two different credentials for two different roles:
#
#   db-password            the application's own role. scripts/bootstrap.py fetches it from
#                          Secrets Manager into the process env at container startup, before
#                          Settings is constructed, which then assembles database_url from it
#                          plus POSTGRES_USER/POSTGRES_DB below.
#   db-superuser-password  the postgres container's bootstrap superuser. Never used by the
#                          running app — only by the deploy (migrations, then
#                          scripts/provision_app_role.py), which passes it as
#                          POSTGRES_SUPERUSER_PASSWORD. See .github/actions/ssm-migrate-deploy.
#
# The two values must differ. POSTGRES_USER below is unprivileged precisely so it cannot bypass
# row-level security — this service's only enforcement of owner isolation — and reusing one
# password would hand that bypass to anything holding the application's credentials. The app
# refuses to start if it ever connects as a role that can bypass RLS (scripts/bootstrap.py).
#
# AWS_REGION is read directly by bootstrap.py (not part of the Settings model) so it can find
# Secrets Manager.
ENV=prod
AWS_REGION=us-east-1
POSTGRES_USER=rag_documents
POSTGRES_DB=rag_documents
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=/opt/model-cache
CHUNK_WINDOW_TOKENS=120
CHUNK_OVERLAP_TOKENS=16
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.30
MAX_QUERY_LENGTH=4000
# Requests per hour, fixed window, no burst. Two dimensions: what the operation costs
# (ingest = create/replace; read = search/get/delete) and what the ceiling counts.
# A service token's `sub` is its own `client_id`, so SERVICE_* is one aggregate for the
# whole calling integration; USER_* applies per user of an exchanged token.
# Service ceilings start equal to the user ones — calibration needs the per-stage
# timings that op_completed does not carry yet (spec, deferred decisions).
RATE_LIMIT_USER_INGEST=60
RATE_LIMIT_USER_READ=600
RATE_LIMIT_SERVICE_INGEST=60
RATE_LIMIT_SERVICE_READ=600
JWT_CLOCK_SKEW_SECONDS=30
# auth doesn't exist yet — these three are placeholders to fill in once it's deployed, same
# open item as dev's JWKS stub.
JWKS_URL=https://auth.hola.host/.well-known/jwks.json
EXPECTED_ALGORITHM=RS256
EXPECTED_ISSUER=https://auth.hola.host
EXPECTED_AUDIENCE=rag-documents
