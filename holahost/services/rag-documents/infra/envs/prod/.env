# Non-secret runtime settings for prod. Committed (no secrets here — the DB password is
# deliberately absent: bootstrap.py fetches it from Secrets Manager directly into the process
# env at container startup, before Settings is constructed, then builds DATABASE_URL from it
# plus POSTGRES_USER/POSTGRES_DB below). AWS_REGION is read directly by bootstrap.py (not part
# of the Settings model) so it can find Secrets Manager.
ENV=prod
AWS_REGION=us-east-1
POSTGRES_USER=rag_documents
POSTGRES_DB=rag_documents
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=/opt/model-cache
CHUNK_WINDOW_TOKENS=120
CHUNK_OVERLAP_TOKENS=16
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.30
MAX_QUERY_LENGTH=4000
RATE_LIMIT_DEFAULT=600
RATE_LIMIT_INGEST=60
JWT_CLOCK_SKEW_SECONDS=30
# auth doesn't exist yet — these three are placeholders to fill in once it's deployed, same
# open item as dev's JWKS stub (.build-state/.../clarifications.md "Dev JWT minting — deferred").
JWKS_URL=https://auth.hola.host/.well-known/jwks.json
EXPECTED_ALGORITHM=RS256
EXPECTED_ISSUER=https://auth.hola.host
EXPECTED_AUDIENCE=rag-documents
