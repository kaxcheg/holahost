# hola.host — DEV config (env: dev). COMMITTED, single source of truth for backend + frontend.
#
# Used directly as the docker-compose `api` env_file, and read by the frontend build (`vite --mode dev`,
# keys ENV / API_BASE_URL). The committed template is `.env.example` (secrets blank);
# the literal `.env` is git-ignored. The boto/S3 sample params are unused in dev (file sample source).
#
# SECRETS: dev values are low-stakes (local Postgres creds, dev salt, unused Resend key) and committed.
# SAMPLE_SERVER_API_KEY (a low-budget Anthropic key) is the one real secret — left EMPTY here and read from
# a console prompt by `make dev-up` (never stored in this file; or `export SAMPLE_SERVER_API_KEY=…` first).
# Staging/prod never use this file: there, non-secret vars are Lambda env (Terraform) and secrets are in
# AWS Secrets Manager.

# ── Deployment ───────────────────────────────────────────────────────────────
ENV=dev
API_BASE_URL=/api/capture-lead                          # frontend only

# ── Models / LLM ─────────────────────────────────────────────────────────────
MODEL_ID_SAMPLE=claude-haiku-4-5-20251001
MODEL_ID_REAL=claude-sonnet-4-6
SYSTEM_PROMPT=You are a helpful STR host assistant.
MAX_OUTPUT_TOKENS=1000
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_SECONDS=30.0
HAIKU_OUTPUT_PRICE_PER_MTOK=1.0

# ── Sample budget / rate limits ──────────────────────────────────────────────
SAMPLE_BUDGET_DAILY_CAP_TOKENS=200000
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_MAGIC_LINK=60
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_RATE_LIMIT_WINDOW_SECONDS=3600

# ── Ingestion / chunking / retrieval ─────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=4194304
MIN_UPLOAD_SIZE_BYTES=1
ALLOWED_MIME_TYPES=["application/pdf","text/plain"]   # frozenset[str] → JSON array (pydantic-settings)
MIN_EXTRACTED_TEXT_CHARS=20
MAX_CHUNKS_PER_GUIDEBOOK=500
MIN_CHUNKS_PER_GUIDEBOOK=1
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SAMPLE_GUIDEBOOK_PATH=docs/sample_guidebook.md
MAX_CHUNK_TOKENS=128
CHUNK_WINDOW=120
CHUNK_OVERLAP=16
RETRIEVAL_TOP_K=5

# ── Magic link / guidebook TTL ───────────────────────────────────────────────
MAGIC_LINK_TTL_DAYS=30
MAGIC_LINK_TOKEN_BYTES=32
CLEANUP_BATCH_SIZE=100

# ── Email (dev → Mailpit over SMTP) ──────────────────────────────────────────
RESEND_FROM=dev@hola.host
EMAIL_TIMEOUT_SECONDS=10.0
FRONTEND_ORIGIN=http://localhost:5173       # dev CORS origin (Vite dev server)
SMTP_HOST=mailpit                           # docker-compose service name
SMTP_PORT=1025

# ── Secrets (dev) ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://holahost:holahost@postgres:5432/holahost   # compose service host
IP_HASH_SALT=dev-local-salt
RESEND_API_KEY=re_dev_unused                # dev email goes via Mailpit; required but unused
SAMPLE_SERVER_API_KEY=                       # EMPTY on purpose — provided at runtime by `make dev-up`
