# hola.host — STAGING config (env: staging). COMMITTED, NON-SECRET only.
#
# Terraform (I-12) injects these as Lambda env vars; the frontend bakes the FE subset (`vite --mode staging`).
# NOT here — each has a single source elsewhere, Terraform injects it at deploy (I-12): AWS_REGION (Lambda
# runtime, reserved) · AWS_RESOURCES_REGION (= deploy region, config.yaml aws_region) · FRONTEND_ORIGIN
# (config.yaml domain/subdomain) · SAMPLE_GUIDEBOOK_S3_BUCKET (config.yaml frontend_bucket) ·
# SAMPLE_GUIDEBOOK_S3_KEY (s3_frontend object key) · SYSTEM_PROMPT / SYSTEM_PROMPT_S3_* (fetched from
# S3 at cold start from the private prefix system-prompt/<env>.md, D-30).
# Secrets live in AWS Secrets Manager (prefix holahost/staging/), loaded at cold start by scripts/bootstrap.py:
#   database_url, resend_api_key, ip_hash_salt, sample_server_api_key

# ── Deployment ───────────────────────────────────────────────────────────────
ENV=staging
API_BASE_URL=/api/capture-lead

# ── Models / LLM ─────────────────────────────────────────────────────────────
MODEL_ID_SAMPLE=claude-haiku-4-5-20251001
MODEL_ID_REAL=claude-sonnet-4-6
MAX_OUTPUT_TOKENS=1000
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_SECONDS=30.0
HAIKU_OUTPUT_PRICE_PER_MTOK=1.0

# ── Sample budget / rate limits ──────────────────────────────────────────────
SAMPLE_BUDGET_DAILY_CAP_TOKENS=200000
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_MAGIC_LINK=60
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_RATE_LIMIT_WINDOW_SECONDS=3600

# ── Ingestion / chunking / retrieval ─────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=4194304
MIN_UPLOAD_SIZE_BYTES=1
ALLOWED_MIME_TYPES=["application/pdf","text/plain"]
MIN_EXTRACTED_TEXT_CHARS=20
MAX_CHUNKS_PER_GUIDEBOOK=500
MIN_CHUNKS_PER_GUIDEBOOK=1
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_CHUNK_TOKENS=128
CHUNK_WINDOW=120
CHUNK_OVERLAP=16
RETRIEVAL_TOP_K=5

# ── Magic link / guidebook TTL ───────────────────────────────────────────────
MAGIC_LINK_TTL_DAYS=30
MAGIC_LINK_TOKEN_BYTES=32
CLEANUP_BATCH_SIZE=100

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_FROM=noreply@hola.host
EMAIL_TIMEOUT_SECONDS=10.0
