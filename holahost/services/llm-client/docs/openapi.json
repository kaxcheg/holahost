  "info": {
    "description": "Generation through external LLM providers, with model aliases, retries, failover, budgets\nand usage accounting.\n\nErrors answer `{\"error\": {\"code\", \"message\", \"details\"}}`. Branch on `code`: it is the\nerror's identity and it tags `details`, whose shape depends on it. `message` is for a\nperson reading a log — do not parse it, and compose what you show a user from `code` and\n`details`. The HTTP status is a projection of the identity, not a separate fact.\n\nOnly this service's own errors are described below. What the shared edge answers with —\n`401`/`503` for authentication, `429` over the rate limit, `413` for a request body past\nthe transport cap — belongs to the platform contract and is the same for every service\nbehind it. The two `429`s differ by `code`: `RateLimitExceededError` means too often, wait\nseconds; `BudgetExhaustedError` means today's spend is gone, wait for the window to reset.\n",
    "title": "llm-client",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/llm-client/generate": {
      "post": {
        "operationId": "generate_api_llm_client_generate_post",
        "parameters": [
          {
            "description": "1 to 128 characters. A repeat with the same key within the key's lifetime is answered `409 DuplicateRequestError` instead of paying for a second generation; the first answer is not returned again.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "1 to 128 characters. A repeat with the same key within the key's lifetime is answered `409 DuplicateRequestError` instead of paying for a second generation; the first answer is not returned again.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnknownModelErrorResponse"
                }
              }
            },
            "description": "No model answers this name."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateRequestErrorResponse"
                }
              }
            },
            "description": "The key is already in use."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateRejectedResponse"
                }
              }
            },
            "description": "The request could not be served."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateTooManyResponse"
                }
              }
            },
            "description": "`BudgetExhaustedError`: a spend ceiling is exhausted until `details.resets_at`. `RateLimitExceededError`: too many requests in the rate-limit window.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait — until the budget window resets, or the limit's.",
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorResponse"
                }
              }
            },
            "description": "Out of contract — see the log."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpstreamLlmErrorResponse"
                }
              }
            },
            "description": "Every candidate model failed transiently. Retryable."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Generate",
        "tags": [
          "generation"
        ]
      }
    },
    "/api/llm-client/health": {
