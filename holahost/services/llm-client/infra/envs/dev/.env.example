ENV=dev
# config.settings.Settings always assembles database_url from these three (host/port are a
# separate Settings field too, defaulting to the fixed "postgres"/5432 convention — not
# env-specific, not set here) — one source, not a separate DATABASE_URL literal that could
# disagree with itself.
#
# POSTGRES_USER/POSTGRES_PASSWORD are the APPLICATION's own role: unprivileged, created by
# scripts/provision_app_role.py during `make migrate-dev`, holding DML grants only, and deliberately
# NOT the postgres container's initdb superuser (docker-compose.yml gives that one its own name and
# password — POSTGRES_SUPERUSER/POSTGRES_SUPERUSER_PASSWORD below), which alone runs the DDL.
POSTGRES_USER=llm_client
POSTGRES_PASSWORD=llm_client
POSTGRES_DB=llm_client

# The postgres container's bootstrap superuser password — the credential migrations and role
# provisioning authenticate with, never the running app. Present in this file only because dev
# has no Secrets Manager; staging/prod carry NEITHER password here and fetch both from it.
#
# In this file rather than as a literal in the Makefile, because this file is the only source
# that reaches both consumers from one declaration: `--env-file` feeds Compose's `${...}`
# interpolation (docker-compose.yml's `postgres` service), and the `env_file:` key feeds the
# one-off `api` containers where SuperuserSettings reads it. The Makefile could only reach the
# first, so it had to pass the value twice, on every command.
#
# Not a secret at dev's threat level: no environment publishes a Postgres port at all, so this
# role is reachable only from inside the compose project's own network. It must still differ
# from POSTGRES_PASSWORD above: sharing one value would hand the DDL rights to anything holding
# the app's credentials.
POSTGRES_SUPERUSER_PASSWORD=dev-bootstrap-superuser-not-a-secret
# Requests per hour, fixed window, no burst — one pair per bucket `interface/http/edge.py`'s
# `bucket_for` returns, matching the `rate_limit_*_<bucket>` fields in config/settings.py.
# A service token's `sub` is its own `client_id`, so SERVICE_* is one aggregate for the
# whole calling integration; USER_* applies per user of an exchanged token.
RATE_LIMIT_USER_GENERATE=60
RATE_LIMIT_SERVICE_GENERATE=600
# The budget's daily ceilings in tokens, input and output apart. The downgrade pool's figures are
# placeholders until the first caller uses the `downgrade` policy.
BUDGET_CAP_CLIENT_INPUT_TOKENS=2000000
BUDGET_CAP_CLIENT_OUTPUT_TOKENS=200000
BUDGET_CAP_CLIENT_DOWNGRADE_INPUT_TOKENS=200000
BUDGET_CAP_CLIENT_DOWNGRADE_OUTPUT_TOKENS=20000
BUDGET_CAP_PROVIDER_INPUT_TOKENS=10000000
BUDGET_CAP_PROVIDER_OUTPUT_TOKENS=1000000
# How long a repeated Idempotency-Key is recognised as a duplicate.
IDEMPOTENCY_KEY_TTL_SECONDS=900
# One variable per enabled provider of app/config/registry.yaml, named after its `api_key_ref`
# (config/provider_keys.py). Staging/prod carry none: bootstrap fetches them from Secrets Manager.
ANTHROPIC_API_KEY=replace-with-a-real-key-to-call-anthropic
JWT_CLOCK_SKEW_SECONDS=30
# Until auth exists, tokens come from the dev minter (holahost/tools/dev-minter): `make dev-up`
# there starts it on `backbone`, where this service's container reaches it by name.
JWKS_URL=http://dev-minter:8081/.well-known/jwks.json
EXPECTED_ALGORITHM=RS256
EXPECTED_ISSUER=holahost-dev
EXPECTED_AUDIENCE=llm-client
# Not rag-documents' 8080: guest-reply calls both services, so both run at once on one host.
HOST_PORT=8081
