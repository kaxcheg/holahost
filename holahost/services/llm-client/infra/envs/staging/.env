# Non-secret runtime settings for staging. Committed on purpose: neither database password nor any
# provider key is here — they live in Secrets Manager, and docs/runbook.md says which is which.
# AWS_REGION is read directly by app/scripts/bootstrap.py, before Settings exists, so it can reach
# Secrets Manager at all.
ENV=staging
AWS_REGION=us-east-1
POSTGRES_USER=llm_client
POSTGRES_DB=llm_client
# Requests per hour, fixed window, no burst. A service token's `sub` is its own `client_id`, so
# SERVICE_* is one aggregate for the whole calling integration; USER_* applies per user of an
# exchanged token.
RATE_LIMIT_USER_GENERATE=60
RATE_LIMIT_SERVICE_GENERATE=600
# The budget's daily ceilings in tokens, input and output apart — a tenth of prod's: staging checks
# the rollout, it does not serve traffic worth paying for. The downgrade pool's figures are
# placeholders until the first caller uses the `downgrade` policy. The budget alarms of this
# directory's Terraform read the provider pair from here.
BUDGET_CAP_CLIENT_INPUT_TOKENS=200000
BUDGET_CAP_CLIENT_OUTPUT_TOKENS=20000
BUDGET_CAP_CLIENT_DOWNGRADE_INPUT_TOKENS=20000
BUDGET_CAP_CLIENT_DOWNGRADE_OUTPUT_TOKENS=2000
BUDGET_CAP_PROVIDER_INPUT_TOKENS=1000000
BUDGET_CAP_PROVIDER_OUTPUT_TOKENS=100000
# How long a repeated Idempotency-Key is recognised as a duplicate.
IDEMPOTENCY_KEY_TTL_SECONDS=900
JWT_CLOCK_SKEW_SECONDS=30
# The issuer these point at does not exist yet; fill them in once it is deployed.
JWKS_URL=https://auth.staging.hola.host/.well-known/jwks.json
EXPECTED_ALGORITHM=RS256
EXPECTED_ISSUER=https://auth.staging.hola.host
EXPECTED_AUDIENCE=llm-client
