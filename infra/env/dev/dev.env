# Non-secret configuration — single source of truth for BOTH backend and frontend (env: dev).
#
# Backend: reads these as environment variables (dev: load this file; staging/prod: Terraform sets
#   them as Lambda env vars from the matching infra/env/<env>/<env>.env).
# Frontend: bakes the FE-relevant subset at build via `vite --mode dev` (see frontend/vite.config.ts).
# Secrets are NEVER stored here (Secrets Manager / a separate untracked file). This file is committed.
ENV=dev
API_BASE_URL=/api
MAGIC_LINK_URL_PARAM=ml
