# hola.host — DEV config TEMPLATE (env: dev). COMMITTED. This mirrors `dev.env` with every secret value
# blanked. `dev.env` is the live file used directly by docker-compose / Vite; copy this to `.env` (git-ignored)
# only for local overrides. See the `dev.env` header for what each block means.
#
# SECRETS (blank below): DATABASE_URL, IP_HASH_SALT, RESEND_API_KEY, SAMPLE_SERVER_API_KEY. In dev the first
# three are low-stakes; SAMPLE_SERVER_API_KEY is read at runtime by `make dev-up`.

# ── Deployment ───────────────────────────────────────────────────────────────
ENV=dev
API_BASE_URL=/api                          # frontend only

# ── Models / LLM ─────────────────────────────────────────────────────────────
MODEL_ID_SAMPLE=claude-haiku-4-5-20251001
MODEL_ID_REAL=claude-sonnet-4-6
SYSTEM_PROMPT=You are a helpful STR host assistant.
MAX_OUTPUT_TOKENS=1000
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_SECONDS=30.0
HAIKU_OUTPUT_PRICE_PER_MTOK=1.0

# ── Sample budget / rate limits ──────────────────────────────────────────────
SAMPLE_BUDGET_DAILY_CAP_TOKENS=200000
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_MAGIC_LINK=60
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_RATE_LIMIT_WINDOW_SECONDS=3600

# ── Ingestion / chunking / retrieval ─────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=4194304
MIN_UPLOAD_SIZE_BYTES=1
ALLOWED_MIME_TYPES=["application/pdf","text/plain"]   # frozenset[str] → JSON array (pydantic-settings)
MIN_EXTRACTED_TEXT_CHARS=20
MAX_CHUNKS_PER_GUIDEBOOK=500
MIN_CHUNKS_PER_GUIDEBOOK=1
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SAMPLE_GUIDEBOOK_PATH=docs/sample_guidebook.md
MAX_CHUNK_TOKENS=128
CHUNK_WINDOW=120
CHUNK_OVERLAP=16
RETRIEVAL_TOP_K=5

# ── Magic link / guidebook TTL ───────────────────────────────────────────────
MAGIC_LINK_TTL_DAYS=30
MAGIC_LINK_TOKEN_BYTES=32
MAGIC_LINK_BASE_URL=http://localhost:5173/claim
MAGIC_LINK_URL_PARAM=ml                     # shared FE/BE
CLEANUP_BATCH_SIZE=100

# ── Email (dev → Mailpit over SMTP) ──────────────────────────────────────────
RESEND_FROM=dev@hola.host
EMAIL_TIMEOUT_SECONDS=10.0
FRONTEND_ORIGIN=http://localhost:5173       # dev CORS origin (Vite dev server)
SMTP_HOST=mailpit                           # docker-compose service name
SMTP_PORT=1025

# ── Secrets (dev) — BLANK in this template ───────────────────────────────────
DATABASE_URL=
IP_HASH_SALT=
RESEND_API_KEY=
SAMPLE_SERVER_API_KEY=
