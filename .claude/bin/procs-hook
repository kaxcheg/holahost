#!/usr/bin/env python3
"""Hook entrypoint:  python3 -I -S "$CLAUDE_PROJECT_DIR/.claude/bin/procs-hook" <guard>

The order below is the fail-open contract. (1) The kill switch — the `global` Procedure's, defined once in
`~/.claude/lib/procs_switch.py` (it needs nothing but `os`). (2) A self-gate that needs nothing but `os`:
a session that is not in a build project pays a few milliseconds and cannot be affected by a bug in the
library. (3) Only then is the library imported and the guard run.
"""

import os
import sys

BUILD_GUARDS = (
    "ledger-context",
    "agent-model",
    "context7-gate",
    "context7-mark",
    "context-watch",
    "ledger-gate",
    "branch-gate",
)
STATE_DEPTH = 3  # the bound of `procs.build.session.state_roots`, which owns where ticket state lives


def has_state(project: str) -> bool:
    """A `.build-state/` at the project root or up to STATE_DEPTH directories down, hidden ones skipped."""
    level = [project]
    for depth in range(STATE_DEPTH + 1):
        if any(os.path.isdir(os.path.join(d, ".build-state")) for d in level):
            return True
        if depth == STATE_DEPTH:
            break
        deeper: list[str] = []
        for d in level:
            try:
                with os.scandir(d) as entries:
                    deeper.extend(e.path for e in entries if e.is_dir() and not e.name.startswith(".") and e.name != "node_modules")
            except OSError:
                continue
        level = deeper
    return False


def main() -> int:
    guard = sys.argv[1] if len(sys.argv) > 1 else ""
    sys.path.insert(0, os.path.expanduser("~/.claude/lib"))
    from procs_switch import guards_off

    if guards_off():
        return 0
    if guard in BUILD_GUARDS and not has_state(os.environ.get("CLAUDE_PROJECT_DIR") or "."):
        return 0
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    sys.path.insert(0, os.path.join(here, "lib"))
    from procs.guards import run

    return run(guard)


if __name__ == "__main__":
    sys.exit(main())
