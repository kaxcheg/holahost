#!/usr/bin/env python3
"""Hook entrypoint:  python3 -I -S "$CLAUDE_PROJECT_DIR/.claude/bin/procs-hook" <guard>

The order below is the fail-open contract. (1) The kill switch. (2) A self-gate that needs nothing but `os`:
a session that is not in a build project pays a few milliseconds and cannot be affected by a bug in the
library. (3) Only then is the library imported and the guard run.
"""

import os
import sys

BUILD_GUARDS = (
    "ledger-context",
    "agent-model",
    "context7-gate",
    "context7-mark",
    "pre-compact",
    "ledger-gate",
    "branch-gate",
)


def main() -> int:
    guard = sys.argv[1] if len(sys.argv) > 1 else ""
    config = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")
    if os.environ.get("PROCS_GUARDS") == "off" or os.path.exists(os.path.join(config, "procs.guards.off")):
        return 0
    if guard in BUILD_GUARDS:
        project = os.environ.get("CLAUDE_PROJECT_DIR") or "."
        if not os.path.isdir(os.path.join(project, ".build-state")):
            return 0
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    sys.path.insert(0, os.path.join(here, "lib"))
    from procs.guards import run

    return run(guard)


if __name__ == "__main__":
    sys.exit(main())
