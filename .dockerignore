# Backend image build context = repo root (to bake .tool-versions + the lead-capture backend). Keep only
# holahost/services/lead-capture/backend/{app,pyproject,poetry.lock} + .tool-versions; trim everything else
# so the context stays small.
.git/
.build-state/
.claude/
**/__pycache__/
**/*.py[cod]
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.coverage
**/node_modules/
**/.terraform/

# The Holahost frontend and the lead-capture IaC are not part of the backend image.
holahost/frontend/
holahost/services/lead-capture/infra/

# Backend: keep app/ + pyproject + lock; drop the rest.
holahost/services/lead-capture/backend/.venv/
holahost/services/lead-capture/backend/tests/
holahost/services/lead-capture/backend/migrations/
holahost/services/lead-capture/backend/Makefile
holahost/services/lead-capture/backend/alembic.ini
holahost/services/lead-capture/backend/Dockerfile
holahost/services/lead-capture/backend/.dockerignore

# docs/ is not part of the image — the sample guidebook is mounted in dev / read from S3 in prod.
holahost/services/lead-capture/docs/
